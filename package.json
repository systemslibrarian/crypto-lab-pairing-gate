{
  "name": "crypto-lab-pairing-gate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:publish-request && tsc --noEmit && vite build",
    "check": "tsc --noEmit && npm test",
    "deploy": "gh workflow run pages.yml --repo systemslibrarian/crypto-lab-pairing-gate --ref main",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "preview": "vite preview",
    "test:a11y": "playwright test",
    "test:mutations": "node scripts/claim-mutations.mjs",
    "test:publish-request": "node --test tests/publish-request.node.mjs",
    "test:workflow": "node --test scripts/workflow-controls.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  }
}
